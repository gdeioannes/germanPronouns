# Google AI Studio key for tool/gen-images.mjs (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google Cloud API key with the Text-to-Speech API enabled, for tool/gen-audio.mjs
# (Chirp 3 HD voices). AI Studio keys are rejected by this API. Cloud console →
# APIs & Services → Credentials → Create API key; restrict it to Text-to-Speech.
GOOGLE_TTS_KEY=
# …or instead, the PATH to a service-account JSON key file (keep the file
# outside the repo; never paste the key itself here).
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# --- Optional login (Firebase) -----------------------------------------------
# Leave these blank and the "Save your progress" section hides itself: the app
# works exactly as before, with progress in localStorage only.
#
# Firebase console → Project settings → Your apps → Web app. These four values
# are PUBLIC by design — they identify the project, they authorise nothing. The
# Firestore security rule is the protection:
#
#   match /databases/{database}/documents {
#     match /users/{uid} {
#       allow read, write: if request.auth != null && request.auth.uid == uid;
#     }
#   }
#
# Also needed in the console: Firestore rules (publish firestore.rules from the
# repo root), Authentication → Sign-in method → Email/Password
# → enable "Email link (passwordless sign-in)", and Authentication → Settings →
# Authorized domains → add languagequiz.org (localhost is there already).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
