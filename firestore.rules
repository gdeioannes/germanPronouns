// Firestore security rules: the optional login's progress sync, and the forum.
//
// Publish: Firebase console → Firestore Database → Rules → paste → Publish,
// or `npx firebase-tools deploy --only firestore` after `npx firebase-tools login`
// (that also creates the composite indexes in firestore.indexes.json).
//
// A "production mode" default (deny all) makes every sync fail with
// permission-denied while sign-in itself still works — these are the rules the
// console must hold.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A moderator is anyone with a forum_admins/{uid} document. Create yours
    // by hand in the console (any content, e.g. { role: "owner" }).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/forum_admins/$(request.auth.uid));
    }

    function text(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // A like moves the parent's counter by one, in the same batch as the
    // likes/{uid} document appearing or disappearing — never on its own.
    function likeBump(likePath) {
      return changedOnly(['likeCount'])
        && ((request.resource.data.likeCount == resource.data.likeCount + 1 && existsAfter(likePath))
          || (request.resource.data.likeCount == resource.data.likeCount - 1 && !existsAfter(likePath)));
    }

    // -- progress sync: one document per learner, theirs alone -----------------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // -- forum -----------------------------------------------------------------
    // Everyone reads. Signed-in learners write their own topics and replies;
    // a reply may bump the parent's counters by exactly one; authors and
    // moderators change status and delete.
    match /forum_threads/{threadId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && text(request.resource.data.title, 140)
        && text(request.resource.data.body, 4000)
        && text(request.resource.data.authorName, 40)
        && request.resource.data.category in ['report', 'question', 'idea', 'general']
        && request.resource.data.status == 'open'
        && request.resource.data.replyCount == 0
        && request.resource.data.notify is bool
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;

      allow update: if signedIn() && (
        // The author: their own text, the notify switch, the status.
        (resource.data.authorUid == request.auth.uid
          && changedOnly(['title', 'body', 'notify', 'status', 'updatedAt'])
          && text(request.resource.data.title, 140)
          && text(request.resource.data.body, 4000)
          && request.resource.data.status in ['open', 'answered', 'fixed'])
        // A moderator: the status.
        || (isAdmin()
          && changedOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['open', 'answered', 'fixed'])
        // Anyone replying: the counters, by exactly one, in their own name.
        || (changedOnly(['replyCount', 'lastReplyAt', 'lastReplyBy', 'lastReplyName', 'updatedAt'])
          && request.resource.data.replyCount == resource.data.replyCount + 1
          && request.resource.data.lastReplyBy == request.auth.uid
          && text(request.resource.data.lastReplyName, 40))
        // The last replier deleting their reply (or their account): clears their
        // own name from the "last reply by" line, nothing else.
        || (resource.data.lastReplyBy == request.auth.uid
          && changedOnly(['lastReplyBy', 'lastReplyName'])
          && request.resource.data.lastReplyBy == null
          && request.resource.data.lastReplyName == null)
        // Anyone liking.
        || likeBump(/databases/$(database)/documents/forum_threads/$(threadId)/likes/$(request.auth.uid))
      );

      // The topic's author may clear its likes too: closing an account removes
      // the topic with everything under it, and children go before the parent.
      match /likes/{uid} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid
          || get(/databases/$(database)/documents/forum_threads/$(threadId)).data.authorUid == request.auth.uid);
      }

      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /posts/{postId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && text(request.resource.data.body, 4000)
          && text(request.resource.data.authorName, 40)
          && request.resource.data.createdAt is number;
        allow update: if signedIn() && (
          (resource.data.authorUid == request.auth.uid
            && changedOnly(['body', 'updatedAt'])
            && text(request.resource.data.body, 4000))
          || likeBump(/databases/$(database)/documents/forum_threads/$(threadId)/posts/$(postId)/likes/$(request.auth.uid))
        );
        // The reply's author, a moderator, or the topic's author (clearing out
        // their own topic when they close their account).
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid
          || isAdmin()
          || get(/databases/$(database)/documents/forum_threads/$(threadId)).data.authorUid == request.auth.uid);

        match /likes/{uid} {
          allow read: if true;
          allow create: if signedIn() && request.auth.uid == uid;
          allow delete: if signedIn() && (request.auth.uid == uid
            || get(/databases/$(database)/documents/forum_threads/$(threadId)/posts/$(postId)).data.authorUid == request.auth.uid
            || get(/databases/$(database)/documents/forum_threads/$(threadId)).data.authorUid == request.auth.uid);
        }
      }
    }

    // Collection-group reads, for "download / delete my data": every reply and
    // every like a learner left, wherever it sits. Both are public anyway.
    match /{path=**}/posts/{postId} {
      allow read: if true;
    }
    match /{path=**}/likes/{likeId} {
      allow read: if true;
    }

    // The learner's posting name and which replies they have read: theirs alone.
    match /forum_profiles/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && (!('name' in request.resource.data) || text(request.resource.data.name, 40));
    }

    // Moderators: readable by the person themselves (so the UI can show the
    // tools), written only from the console.
    match /forum_admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // -- site feedback -----------------------------------------------------------
    // The site owner: a site_owners/{uid} document, created by hand in the
    // console (any content, e.g. { role: "owner" }). Separate from forum
    // moderators on purpose: only the owner reads the feedback.
    function isSiteOwner() {
      return signedIn() && exists(/databases/$(database)/documents/site_owners/$(request.auth.uid));
    }

    function feedbackText(value) {
      return value is string && value.size() <= 2000;
    }

    match /site_owners/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    function shortText(value, max) {
      return value is string && value.size() <= max;
    }

    // Anyone adds an answer, no login: stars 1–5, optional texts, where it was
    // given (the site card, the menu, a printed book's code). Nobody but the
    // owner reads or deletes. The browser that made an answer may add its
    // texts once, within the hour (it alone knows the random id: the stars
    // are saved on the tap, the texts follow).
    match /feedback/{id} {
      allow read, delete: if isSiteOwner();
      allow create: if request.resource.data.keys().hasOnly(['rating', 'comment', 'wish', 'mistake', 'quote', 'name', 'quoteOk', 'page', 'source', 'book', 'code', 'lang', 'at'])
        && request.resource.data.keys().hasAll(['rating', 'comment', 'wish', 'mistake', 'quote', 'name', 'quoteOk', 'page', 'source', 'book', 'code', 'lang', 'at'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && feedbackText(request.resource.data.comment)
        && feedbackText(request.resource.data.wish)
        && feedbackText(request.resource.data.mistake)
        && shortText(request.resource.data.quote, 400)
        && shortText(request.resource.data.name, 40)
        && request.resource.data.quoteOk is bool
        && text(request.resource.data.page, 200)
        && request.resource.data.source in ['ask', 'menu', 'book']
        && shortText(request.resource.data.book, 10)
        && shortText(request.resource.data.code, 40)
        && text(request.resource.data.lang, 5)
        && request.resource.data.at is int;
      allow update: if changedOnly(['comment', 'wish', 'mistake', 'quote', 'name', 'quoteOk'])
        && resource.data.comment == ''
        && resource.data.wish == ''
        && resource.data.mistake == ''
        && resource.data.quote == ''
        && feedbackText(request.resource.data.comment)
        && feedbackText(request.resource.data.wish)
        && feedbackText(request.resource.data.mistake)
        && shortText(request.resource.data.quote, 400)
        && shortText(request.resource.data.name, 40)
        && request.resource.data.quoteOk is bool
        && request.time.toMillis() - resource.data.at < 3600000;
    }

    // "Who is this book for?" at a PDF download. Same pattern: anyone adds,
    // the school or course may follow once within the hour, only the owner
    // reads or deletes.
    match /book_audience/{id} {
      allow read, delete: if isSiteOwner();
      allow create: if request.resource.data.keys().hasOnly(['who', 'school', 'book', 'lang', 'at'])
        && request.resource.data.who in ['me', 'class', 'child', 'other']
        && request.resource.data.school == ''
        && shortText(request.resource.data.book, 10)
        && text(request.resource.data.lang, 5)
        && request.resource.data.at is int;
      allow update: if changedOnly(['school'])
        && resource.data.school == ''
        && text(request.resource.data.school, 200)
        && request.time.toMillis() - resource.data.at < 3600000;
    }

    // Quotes the owner published from the inbox (the reader ticked "you may
    // quote me"): everyone reads them on /books, only the owner writes.
    match /book_quotes/{id} {
      allow read: if true;
      allow write: if isSiteOwner();
    }

    // -- Wortblöcke world Bestenliste ----------------------------------------
    // The arcade way: everyone reads the board, anyone may append ONE score
    // with a five-letter name — no login, like the cabinets. Shape-checked,
    // append-only; moderators can prune.
    match /wort_scores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'pts', 'level', 'at'])
        && text(request.resource.data.name, 5)
        && request.resource.data.pts is int
        && request.resource.data.pts > 0
        && request.resource.data.pts < 1000000
        && text(request.resource.data.level, 10)
        && request.resource.data.at is int;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
