          "b": "null · eins · zwei · drei"
        },
        {
          "a": "4 · 5 · 6 · 7",
          "b": "vier · fünf · sechs · sieben"
        },
        {
          "a": "8 · 9 · 10",
          "b": "acht · neun · zehn"
        }
      ]
    },
    "z = ts, ei = eye, ie = ee": {
      "kind": "pairs",
      "left": "written",
      "right": "say it like",
      "rows": [
        {
          "a": "zwei, zehn",
          "b": "tsvai, tsayn",
          "note": "German z is always ts."
        },
        {
          "a": "drei, zwei",
          "b": "dry, tsvai",
          "note": "ei rhymes with English eye."
        },
        {
          "a": "vier, sieben",
          "b": "feer, zee-ben",
          "note": "ie is a long ee."
        }
      ]
    }
  },
  "quest_a1_1_pronomen": {
    "The nine forms": {
      "kind": "people",
      "caption": "Six rows to learn: er, sie and es share one row, and so do sie (they) and Sie (you, formal).",
      "persons": [
        "I",
        "you (friend)",
        "he / she / it",
        "we",
        "you (group)",
        "they / you (formal)"
      ],
      "columns": [
        {
          "label": "subject",
          "forms": [
            "ich",
            "du",
            "er / sie / es",
            "wir",
            "ihr",
            "sie / Sie"
          ]
        }
      ]
    },
    "du or Sie?": {
      "kind": "tree",
      "root": {
        "q": "Is it a child, a family member, a friend, or someone you call by first name?",
        "yes": {
          "answer": "du",
          "de": "Wie heißt du?"
        },
        "no": {
          "q": "Is it a stranger, a colleague you don't know well, or an official?",
          "yes": {
            "answer": "Sie",
            "de": "Wie heißen Sie?"
          },
          "no": {
            "answer": "Sie, until they offer du",
            "de": "Wir können uns duzen."
          }
        }
      }
    }
  },
